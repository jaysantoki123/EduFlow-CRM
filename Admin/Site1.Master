<%@ Master Language="C#" AutoEventWireup="true"
    CodeBehind="Site1.Master.cs"
    Inherits="EduFlow.Site1" %>


<!DOCTYPE html>

<html>
<head runat="server">

    <meta charset="utf-8" />

    <meta name="viewport"
        content="width=device-width, initial-scale=1.0" />

    <title>
        <asp:ContentPlaceHolder
            ID="TitleContent"
            runat="server">
            EduFlow CRM

        </asp:ContentPlaceHolder>
    </title>


    <!-- Font Awesome -->
    <link rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">


    <!-- Global CSS -->
    <link href="<%: ResolveUrl("~/Content/Site.css") %>"
        rel="stylesheet"
        type="text/css" />


    <!-- Page-specific Head Content -->
    <asp:ContentPlaceHolder
        ID="HeadContent"
        runat="server">
    </asp:ContentPlaceHolder>

</head>


<body>

    <form id="form1" runat="server">

        <div class="app-container">


            <!-- ================================================= -->
            <!-- SIDEBAR -->
            <!-- ================================================= -->

            <aside class="sidebar" id="sidebar">


                <!-- SIDEBAR HEADER -->

                <div class="sidebar-header">

                    <div class="sidebar-logo">

                        <i class="fas fa-graduation-cap"></i>

                    </div>

                    <div class="sidebar-brand">

                        <h2>EduCRM</h2>

                        <p>Admission Manager</p>

                    </div>

                </div>


                <!-- SIDEBAR NAVIGATION -->

                <nav class="sidebar-nav">


                    <!-- MAIN -->

                    <div class="nav-section">

                        <div class="nav-section-title">
                            Main
                        </div>

                        <ul class="nav-items">

                            <li class="nav-item">

                                <a href="<%= ResolveUrl("~/Admin/Dashboard.aspx") %>"
                                    class="nav-link active">

                                    <i class="fas fa-home"></i>

                                    <span class="nav-link-text">Dashboard
                                    </span>

                                </a>

                            </li>

                        </ul>

                    </div>


                    <!-- MANAGEMENT -->

                    <div class="nav-section">

                        <div class="nav-section-title">
                            Management
                        </div>

                        <ul class="nav-items">


                            <li class="nav-item">

                                <a href="<%= ResolveUrl("~/Admin/Inquiries.aspx") %>"
                                    class="nav-link">

                                    <i class="fas fa-clipboard-list"></i>

                                    <span class="nav-link-text">Inquiries
                                    </span>

                                </a>

                            </li>


                            <li class="nav-item">

                                <a href="<%= ResolveUrl("~/Admin/Counseling.aspx") %>"
                                    class="nav-link">

                                    <i class="fas fa-user-tie"></i>

                                    <span class="nav-link-text">Counseling
                                    </span>

                                </a>

                            </li>


                            <li class="nav-item">

                                <a href="<%= ResolveUrl("~/Admin/FollowUps.aspx") %>"
                                    class="nav-link">

                                    <i class="fas fa-phone-alt"></i>

                                    <span class="nav-link-text">Follow-ups
                                    </span>

                                </a>

                            </li>


                            <li class="nav-item">

                                <a href="<%= ResolveUrl("~/Admin/Applications.aspx") %>"
                                    class="nav-link">

                                    <i class="fas fa-file-alt"></i>

                                    <span class="nav-link-text">Applications
                                    </span>

                                </a>

                            </li>


                            <li class="nav-item">

                                <a href="<%= ResolveUrl("~/Admin/Students.aspx") %>"
                                    class="nav-link">

                                    <i class="fas fa-user-graduate"></i>

                                    <span class="nav-link-text">Students
                                    </span>

                                </a>

                            </li>


                        </ul>

                    </div>


                    <!-- SYSTEM -->

                    <div class="nav-section">

                        <div class="nav-section-title">
                            System
                        </div>

                        <ul class="nav-items">


                            <li class="nav-item">

                                <a href="<%= ResolveUrl("~/Admin/Courses.aspx") %>"
                                    class="nav-link">

                                    <i class="fas fa-book"></i>

                                    <span class="nav-link-text">Courses
                                    </span>

                                </a>

                            </li>

                            <li class="nav-item">

                                <a href="<%= ResolveUrl("~/Admin/Users.aspx") %>"
                                    class="nav-link">

                                    <i class="fas fa-users"></i>

                                    <span class="nav-link-text">User
                                    </span>

                                </a>

                            </li>

                            <li class="nav-item">

                                <a href="<%= ResolveUrl("~/Admin/Roles.aspx") %>"
                                    class="nav-link">

                                    <i class="fas fa-user-shield"></i>

                                    <span class="nav-link-text">Roles
                                    </span>

                                </a>

                            </li>

                            <li class="nav-item">

                                <a href="<%= ResolveUrl("~/Admin/Reports.aspx") %>"
                                    class="nav-link">

                                    <i class="fas fa-chart-bar"></i>

                                    <span class="nav-link-text">Reports
                                    </span>

                                </a>

                            </li>

                            <li class="nav-item">

                                <a href="<%= ResolveUrl("~/Admin/Settings.aspx") %>"
                                    class="nav-link">

                                    <i class="fas fa-cog"></i>

                                    <span class="nav-link-text">Setting
                                    </span>

                                </a>

                            </li>


                        </ul>

                    </div>


                    <!-- ACCOUNT -->

                    <div class="nav-section">

                        <div class="nav-section-title">
                            Account
                        </div>

                        <ul class="nav-items">


                            <li class="nav-item">

                                <a href="<%= ResolveUrl("~/Admin/Profile.aspx") %>"
                                    class="nav-link">

                                    <i class="fas fa-user-circle"></i>

                                    <span class="nav-link-text">My Profile
                                    </span>

                                </a>

                            </li>


                            <li class="nav-item">

                                <a href="<%= ResolveUrl("~/Authentication/Login.aspx") %>"
                                    class="nav-link text-danger"
                                    id="sidebarLogout">

                                    <i class="fas fa-sign-out-alt"></i>

                                    <span class="nav-link-text">Logout
                                    </span>

                                </a>

                            </li>


                        </ul>

                    </div>


                </nav>


                <!-- SIDEBAR FOOTER -->

                <div class="sidebar-footer">

                    <div class="sidebar-user">

                        <div class="sidebar-user-avatar">
                            AM
                        </div>

                        <div class="sidebar-user-info">

                            <p class="sidebar-user-name">
                                Admission Manager
                            </p>

                            <p class="sidebar-user-role">
                                Admission Manager
                            </p>

                        </div>

                    </div>

                </div>


            </aside>


            <!-- ================================================= -->
            <!-- MAIN AREA -->
            <!-- ================================================= -->

            <div class="main-area">


                <!-- TOPBAR -->





                <!-- ================================================= -->
                <!-- PAGE CONTENT -->
                <!-- ================================================= -->

                <main class="page-content">

                    <asp:ContentPlaceHolder
                        ID="MainContent"
                        runat="server">
                    </asp:ContentPlaceHolder>

                </main>


            </div>


        </div>

    </form>


    <script>

        function toggleSidebar() {

            document
                .querySelector(".app-container")
                .classList.toggle("sidebar-collapsed");

        }

        document.addEventListener("DOMContentLoaded", function () {

            var sidebar = document.getElementById("sidebar");

            if (!sidebar) {
                return;
            }


            /* =====================================================
               RESTORE SIDEBAR POSITION
               ===================================================== */

            var savedScrollPosition =
                sessionStorage.getItem("EduCRM_SidebarScroll");


            if (savedScrollPosition !== null) {

                sidebar.scrollTop =
                    parseInt(savedScrollPosition, 10);

            }


            /* =====================================================
               SAVE POSITION WHEN A SIDEBAR LINK IS CLICKED
               ===================================================== */

            var sidebarLinks =
                sidebar.querySelectorAll("a");


            sidebarLinks.forEach(function (link) {

                link.addEventListener("click", function () {

                    sessionStorage.setItem(
                        "EduCRM_SidebarScroll",
                        sidebar.scrollTop
                    );

                });

            });


            /* =====================================================
               ALSO SAVE POSITION WHILE SIDEBAR IS SCROLLING
               ===================================================== */

            sidebar.addEventListener("scroll", function () {

                sessionStorage.setItem(
                    "EduCRM_SidebarScroll",
                    sidebar.scrollTop
                );

            });

        });

    </script>




</body>

</html>



